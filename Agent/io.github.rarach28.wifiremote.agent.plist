<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The WiFi Remote agent: registered by the app with SMAppService, started at login, restarted if it exits. -->
<plist version="1.0"><dict>
    <key>Label</key><string>io.github.rarach28.wifiremote.agent</string>
    <key>BundleProgram</key><string>Contents/MacOS/WiFiRemote</string>
    <key>ProgramArguments</key><array><string>WiFiRemote</string><string>--agent</string></array>
    <key>AssociatedBundleIdentifiers</key><array><string>io.github.rarach28.wifiremote</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Interactive</string>
</dict></plist>
